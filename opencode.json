{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": ["skills"]
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      ".env": "deny",
      "**/.env.*": "deny",
      ".env.*": "deny",
      "**/.env.example": "allow",
      ".env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "docker compose down -v": "ask",
      "rm -rf *": "ask"
    }
  }
}
