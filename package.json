{
  "name": "my-payment-gateway-showcase",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run lint typecheck test",
    "db:generate": "pnpm --filter @pay/api db:generate",
    "db:migrate": "pnpm --filter @pay/api db:migrate",
    "db:seed": "pnpm --filter @pay/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:race": "node scripts/race-webhook.mjs",
    "test:e2e": "pnpm --filter @pay/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
